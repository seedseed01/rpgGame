@{
    ViewData["Title"] = "遊戲下載 - 文字 RPG 冒險指南";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-retro p-4 p-md-5 text-center">
            <div class="text-retro-green fs-1 mb-2">💾</div>
            <h2 class="text-white fw-bold mb-3">遊戲下載與發布版本</h2>
            <p class="text-secondary mb-4">
                本遊戲為免安裝版本，下載解壓縮後即可直接執行 `.exe` 開始冒險！最新原始碼與 release 檔案皆託管於 GitHub。
            </p>

            <!-- 點擊直接跳轉到你的 GitHub Release 頁面 -->
            <div class="my-4">
                <a href="https://github.com/seedseed01/rpg/releases" target="_blank" class="btn btn-retro-success btn-lg px-5 py-3 fs-5 font-monospace">
                    🚀 前往 GitHub Release 下載頁面
                </a>
            </div>

            <p class="text-primary fs-7 mb-0">
                （將開啟新分頁連線至 GitHub 倉庫下載專案 release `.zip`）
            </p>

            <hr class="border-secondary my-5">

            <!-- 系統需求說明 -->
            <div class="text-start">
                <h5 class="text-retro-gold mb-3">💻 系統需求說明</h5>
                <ul class="text-secondary fs-7 lh-lg mb-0">
                    <li><strong class="text-white">作業系統：</strong> Windows 10 (64-bit)</li>
                    <li><strong class="text-white">環境需求：</strong> 已採用 Single-File 技術打包，電腦<span class="text-retro-green">無需額外安裝</span> .NET Runtime 即可直接執行！</li>
                    <li><strong class="text-white">硬體需求：</strong> 任何支援主機板文字 Terminal 的 CPU 即可順暢執行。</li>
                </ul>
            </div>
        </div>
    </div>
</div>